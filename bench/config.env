# Every pin of the experiment. bench.py and build_assets.py read this file
# (or the one --config names) and copy it into each run's manifest. Lines are
# KEY=VALUE, valid as bash assignments.

# Claude Code in every container, and the SDK's bundled CLI (bench/requirements.txt).
CLAUDE_CODE_VERSION=2.1.318

# Bedrock: the same model for every arm. Every model alias Claude Code or
# AI-DLC can pick (an AI-DLC reviewer pins `sonnet`, Claude Code's Explore
# agent and small calls use `haiku`) points at this model too.
# Open decision for warren: which model.
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_DEFAULT_OPUS_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_DEFAULT_SONNET_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_DEFAULT_HAIKU_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# AI-DLC (arms 2 and 3), installed offline from the release files in the assets.
AIDLC_VERSION=2.11.3
AIDLC_RELEASE_URL=https://github.com/awslabs/aidlc-workflows/releases/download

# The security plugin (arm 3): this repository at PLUGIN_COMMIT, built with the
# aidlc-workflows tools at the commit CI pins (.github/workflows/ci.yml).
PLUGIN_COMMIT=76ecd719fa2866f5a00a21d164bc2fb6cb552d56
AIDLC_WORKFLOWS_URL=https://github.com/awslabs/aidlc-workflows
AIDLC_WORKFLOWS_BUILD_COMMIT=cc22ef5564b159553057962ea874d4e1b855ccad
SECURITY_AGENT_MCP=awslabs.security-agent-mcp-server@0.2.1
SECURITY_AGENT_REGION=ap-southeast-1
BUN_VERSION=1.4.4
UV_VERSION=0.13.7

# Benchmarks. SUSVIBES_FORK_COMMIT empty: `bench.py setup` resolves the branch
# head and records the commit in the work dir's manifest.
SUSVIBES_FORK_URL=https://github.com/warren830/susvibes
SUSVIBES_FORK_BRANCH=bench/aidlc-arms
SUSVIBES_FORK_COMMIT=
BAXBENCH_URL=https://github.com/logic-star-ai/baxbench
BAXBENCH_REF=v1.0.0

# The run: identical for every arm. The Security Agent server's setup creates
# AWS resources and call_api reaches every service operation (pentests are
# billed): no run may use either. The plugin needs neither.
TIMEOUT_SECONDS=10800
WORKERS=8
ALLOWED_TOOLS=Bash,Edit,Write,Read,Glob,Grep,LS,WebFetch,NotebookEdit,NotebookRead,TodoRead,TodoWrite,Agent,Skill,Task,mcp__security-agent__*
DISALLOWED_TOOLS=mcp__security-agent__setup,mcp__security-agent__call_api
