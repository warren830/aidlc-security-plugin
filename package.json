{
  "name": "aidlc-security-plugin-dev",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Dev tooling for the AI-DLC security plugin. The plugin itself is security/; its harness projections build into security/dist/<harness>/.",
  "scripts": {
    "validate": "bun scripts/plugin-tool.ts validate security",
    "build:claude": "bun scripts/plugin-tool.ts build security claude",
    "build:kiro-ide": "bun scripts/plugin-tool.ts build security kiro-ide",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "test": "bun test tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "bun-types": "^1.3.13",
    "typescript": "^6.0.3"
  }
}
